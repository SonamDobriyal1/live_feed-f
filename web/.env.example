# Web dashboard — copy:  cp .env.example .env
# Camera / Twilio / SMS do not belong here.

DAYCARE_TZ=Asia/Kolkata
PORTAL_PORT=8080
PORTAL_DEBUG=false
PORTAL_SECRET_KEY=generate-another-long-random-string
# Must match PORTAL_INGEST_KEY in pi/.env
PORTAL_INGEST_KEY=generate-a-long-random-string

# Same Supabase project as pi/.env (delete + midnight purge)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_STORAGE_BUCKET=detections

# Optional: auto-register daycares on boot (Render)
# WEB_TENANTS=192.168.1.50|camPass|Sunshine Delhi;10.0.0.15|camPass|Sunshine Noida
