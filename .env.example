# =============================================================================
# Live Violence Monitor — deployment configuration
# Copy:  cp .env.example .env
# =============================================================================

# --- Camera (CP Plus / Dahua RTSPS) ---
CAMERA_IP=122.175.45.21
CAMERA_USER=admin
CAMERA_PASS=your_camera_password
RTSP_PORT=554
CAMERA_CHANNEL=1
CAMERA_SUBTYPE=1

# --- Violence detection ---
VIOLENCE_CONF=0.60
VIOLENCE_EVERY_N=3
ALERT_COOLDOWN_SEC=10

# --- Deployment ---
# true = no GUI window (use for servers / Docker)
DEPLOY_HEADLESS=true

# --- SMS alerts (Twilio) — required for notifications ---
SMS_ENABLED=true
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_SMS_FROM=+17372508034

# Comma-separated E.164 numbers (India: +91XXXXXXXXXX)
SMS_TO=+919354501373,+919876543210

# Twilio SMS — sms_internal_alerts (India trial)
# Use template mode (Body=sms_internal_alerts). Do NOT set TWILIO_CONTENT_SID for this.
TWILIO_SMS_TEMPLATE=sms_internal_alerts
TWILIO_SMS_USE_TEMPLATE=true
TWILIO_SMS_MODE=template
# TWILIO_CONTENT_SID=HX...   # only if you have a custom Content Builder template

# --- Optional: log every detection to Supabase ---
SUPABASE_LOGGING=true
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
